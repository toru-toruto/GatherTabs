{
  "manifest_version": 3,
  "name": "Gather Tabs",
  "version": "1.0.0",
  "description": "開いているすべての Chrome ウインドウのタブを、いまのウインドウ 1 つにまとめます。",
  "minimum_chrome_version": "102",
  "permissions": ["tabGroups"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "すべてのウインドウのタブをこのウインドウに集める",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      }
    }
  }
}
